---
export interface Props {
  title?: string;
}

const { title } = Astro.props;
---

<!-- A block on a band: flat, with a strong rule on top. Depth comes from tone and line, never from shadow (7.4). -->
<div class="panel">
  {title && <h3 class="title" data-type="text-md">{title}</h3>}
  <slot />
</div>

<style>
  .panel {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    align-content: start;
    gap: var(--tram-sys-space-4);
    min-inline-size: 0;
    padding: var(--tram-sys-space-4);
    border-block-start: var(--tram-sys-line-strong) solid var(--tram-sys-text);
    background: var(--tram-sys-surface);
  }

  .title {
    margin: 0;
    font-weight: 700;
  }
</style>
