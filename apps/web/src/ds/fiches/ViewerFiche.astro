---
import Viewer3DShell from '@tram/design-system/interactive/Viewer3DShell.astro';
import Fiche from '../Fiche.astro';
import Mode from '../Mode.astro';
import { MODES } from '../nav';

const code = `<Viewer3DShell id="route" label="Recorregut en 3D">
  <svg slot="poster">…</svg>
  <table slot="text">…</table>
</Viewer3DShell>

<script>
  document.querySelector('#route').loader = (context) =>
    import('./scene').then((m) => m.mount(context));
</script>`;
const POSTER = 'M0 70C20 30 35 35 50 55S80 85 100 40';
---

<Fiche
  group="Interactiu"
  js="1,2 KB de JavaScript"
  title="Viewer3DShell"
  use="Tota escena 3D: el visor de rutes i la radiografia de sabatilles hi viuen a dins, i així totes es comporten igual."
  avoid="Contingut que no sigui 3D. El pòster i el text equivalent són obligatoris: el 3D només s'hi suma."
  code={code}
>
  <section class="fiche-block" data-testid="auto">
    <h2 data-type="display-sm">Quan és visible</h2>
    <Viewer3DShell id="demo-auto" label="Escena de demostració">
      <svg slot="poster" class="poster" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true"><path d={POSTER} /></svg>
      <p slot="text" data-type="text-sm" class="fiche-note">Text equivalent: descripció del recorregut, sempre present a l'HTML.</p>
    </Viewer3DShell>
  </section>

  <section class="fiche-block" data-testid="manual">
    <h2 data-type="display-sm">Només en demanar-ho</h2>
    <Viewer3DShell id="demo-manual" label="Escena manual" load="interaction">
      <svg slot="poster" class="poster" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true"><path d={POSTER} /></svg>
    </Viewer3DShell>
  </section>

  <section class="fiche-block" data-testid="error">
    <h2 data-type="display-sm">Error i reintent</h2>
    <p class="fiche-note">Si l'escena falla, el pòster es queda i l'usuari ho pot tornar a provar.</p>
    <Viewer3DShell id="demo-error" label="Escena amb error" load="interaction">
      <svg slot="poster" class="poster" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true"><path d={POSTER} /></svg>
    </Viewer3DShell>
  </section>

  <section class="fiche-block">
    <h2 data-type="display-sm">Modes</h2>
    <div class="fiche-grid">
      {
        MODES.map((m) => (
          <Mode {...m}>
            <div style="inline-size: 100%">
              <Viewer3DShell label={`Pòster ${m.theme} ${m.terrain}`} load="interaction">
                <svg slot="poster" class="poster" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true"><path d={POSTER} /></svg>
              </Viewer3DShell>
            </div>
          </Mode>
        ))
      }
    </div>
  </section>
</Fiche>

<script>
  import type { SceneContext } from '@tram/design-system/interactive/viewer-3d-shell.ts';
  import { createDemoScene } from '../demo-scene';

  void customElements.whenDefined('tram-viewer-3d').then(() => {
    type Viewer = HTMLElement & { loader: (context: SceneContext) => Promise<ReturnType<typeof createDemoScene>> };
    const viewer = (id: string): Viewer => document.getElementById(id) as Viewer;
    const load = async (context: SceneContext) => createDemoScene(context);
    viewer('demo-auto').loader = load;
    viewer('demo-manual').loader = load;

    let attempts = 0;
    viewer('demo-error').loader = async (context) => {
      attempts += 1;
      if (attempts === 1) throw new Error('Demo failure');
      return createDemoScene(context);
    };
  });
</script>

<style>
  .poster {
    display: block;
    inline-size: 100%;
    block-size: 100%;
  }

  .poster path {
    fill: none;
    stroke: var(--tram-sys-text);
    stroke-width: var(--tram-sys-line-strong);
    vector-effect: non-scaling-stroke;
  }
</style>
