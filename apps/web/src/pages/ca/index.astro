---
import Band from '@tram/design-system/primitives/Band.astro';
import Heading from '@tram/design-system/primitives/Heading.astro';
import Link from '@tram/design-system/primitives/Link.astro';
import Panel from '@tram/design-system/primitives/Panel.astro';
import Split from '@tram/design-system/primitives/Split.astro';
import RoutePlate from '@tram/design-system/patterns/RoutePlate.astro';
import Button from '@tram/design-system/primitives/Button.astro';
import Stack from '@tram/design-system/primitives/Stack.astro';
import Text from '@tram/design-system/primitives/Text.astro';
import { DEM_CREDIT, RACES, ROUTES, routeOf, visible } from '../../content';
import Site from '../../layouts/Site.astro';
import RaceList from '../../sections/RaceList.astro';
import RouteList from '../../sections/RouteList.astro';

const races = visible(RACES);
const routes = visible(ROUTES);
const sample = races.some((r) => r.isPlaceholder);
const cover = routeOf('calonge');
---

<Site
  title="Running d'asfalt i de muntanya"
  description="TRAM: curses, rutes i sabatilles de running d'asfalt i de muntanya. Recorreguts en 3D sobre el terreny real, perfils i xifres."
  placeholder={sample}
  notice={sample ? 'Aquesta és una versió de proves: les curses són de mostra; les rutes i les seves xifres són reals.' : undefined}
>
  <Split ratio="3:2">
    <Stack gap={5}>
      <Heading level={1} size="xl" kicker="Running d’asfalt i de muntanya">Recórrer el tram</Heading>
      <Text size="lg" measure>Cada cursa i cada ruta, quilòmetre a quilòmetre: el vol sobre el terreny real, el perfil amb el pendent de cada tram i les xifres com en un full de resultats.</Text>
      <div><Button variant="primary" href={`/ca/rutes/${cover.slug}/`}>{`Recorre ${cover.name} en 3D`}</Button></div>
    </Stack>
    <RoutePlate slot="aside" plate={cover.plate} label={cover.name} credit={DEM_CREDIT} />
  </Split>
  {
    races.length > 0 && (
      <Band tone="tint" title="Curses">
        <Panel>
          <RaceList races={races} />
        </Panel>
        <Link href="/ca/curses/" variant="standalone">Totes les curses</Link>
      </Band>
    )
  }
  <Band tone="alt" title="Rutes">
    <Panel>
      <RouteList routes={routes} />
    </Panel>
    <Link href="/ca/rutes/" variant="standalone">Totes les rutes</Link>
  </Band>
</Site>
