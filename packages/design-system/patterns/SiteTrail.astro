---
export interface Crumb {
  label: string;
  href: string;
}

export interface Props {
  /** The pages above this one, from the home page down. The page itself is not one of them: its title says it, right below. */
  items: readonly Crumb[];
  /** What the list is, for who cannot see it. */
  label?: string;
}

const { items, label = 'Camí fins a aquesta pàgina' } = Astro.props;
---

<!-- Where a page hangs from: the way back up, one step at a time. A line of small text over the page, never a second menu. -->
<nav class="trail" aria-label={label}>
  <ol class="list" data-type="text-sm">
    {items.map((item) => <li class="item"><a class="link" href={item.href}>{item.label}</a></li>)}
  </ol>
</nav>

<style>
  .list {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    margin: 0;
    padding: 0;
    list-style: none;
    color: var(--tram-sys-text-muted);
  }

  .item {
    display: flex;
    align-items: center;
  }

  /* The stroke between two steps belongs to neither: it is not read out, and cannot be followed. */
  .item + .item::before {
    padding-inline: var(--tram-sys-space-2);
    color: var(--tram-sys-rule-strong);
    content: '/';
    content: '/' / '';
  }

  .link {
    padding-block: var(--tram-sys-space-2);
    color: inherit;
    text-decoration: none;
  }

  .link:hover {
    color: var(--tram-sys-text);
    text-decoration: underline;
    text-underline-offset: var(--tram-sys-space-1);
  }

  .link:focus-visible {
    outline: var(--tram-sys-line-strong) solid var(--tram-sys-focus);
    outline-offset: var(--tram-sys-line-strong);
  }
</style>
