---
import { Font } from 'astro:assets';
import '@tram/design-system/tokens.css';
import '@tram/design-system/base.css';
import '@tram/design-system/fonts/fallbacks.css';
import SiteFooter from '@tram/design-system/patterns/SiteFooter.astro';
import SiteFrame from '@tram/design-system/patterns/SiteFrame.astro';
import SiteHeader from '@tram/design-system/patterns/SiteHeader.astro';

export interface Props {
  title: string;
  description: string;
  /** `data-terrain` of the page: a race or a shoe gives the page its world. */
  terrain?: 'road' | 'trail' | 'mixed' | undefined;
  /** Pages built on sample data are never offered to search engines. */
  placeholder?: boolean | undefined;
  credits?: readonly string[] | undefined;
  notice?: string | undefined;
  /** schema.org data of the page (CLAUDE.md 11). */
  jsonLd?: Record<string, unknown> | ReadonlyArray<Record<string, unknown>> | undefined;
}

const { title, description, terrain = 'mixed', placeholder = false, credits, notice, jsonLd } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const LINKS = [
  { href: '/ca/curses/', label: 'Curses' },
  { href: '/ca/rutes/', label: 'Rutes' },
  { href: '/ca/sabatilles/', label: 'Sabatilles' },
];
---

<!doctype html>
<html lang="ca" data-terrain={terrain}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{`${title} · TRAM`}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {placeholder && <meta name="robots" content="noindex, nofollow" />}
    <Font cssVariable="--tram-ref-font-display" preload />
    <Font cssVariable="--tram-ref-font-text" preload />
    <!-- Before the first paint: the theme the reader chose, not the one of the phone. -->
    <script is:inline>
      try {
        if (localStorage.getItem('tram-theme') === 'night') document.documentElement.dataset.theme = 'night';
      } catch {}
    </script>
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
  </head>
  <body data-type="text-md">
    <SiteFrame>
      <SiteHeader slot="header" home="/ca/" links={LINKS} current={Astro.url.pathname} />
      <slot />
      <SiteFooter slot="footer" credits={credits} notice={notice} />
    </SiteFrame>
  </body>
</html>
