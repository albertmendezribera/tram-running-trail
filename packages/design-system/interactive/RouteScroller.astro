---
import { formatNumber, type Locale } from '@tram/formats';
import ElevationProfile from '../patterns/ElevationProfile.astro';
import RouteSilhouette from './RouteSilhouette.astro';
import SegmentedControl, { type Option } from './SegmentedControl.astro';
import Viewer3DShell from './Viewer3DShell.astro';
import { areaPath, createPlot, detectClimbs, elevationAt, GRADE_LABELS, gradeAt, linePath, type ProfilePoint, summarize } from '../patterns/elevation.ts';

export interface Props {
  /** Kilometre and elevation in metres, ordered by distance. */
  points: readonly ProfilePoint[];
  /** Name of the route or race. */
  name: string;
  locale?: Locale;
  /** Needed when a page has more than one scroller: names the place the skip link jumps to. */
  id?: string;
  /**
   * Adds a 3D view over the silhouette, which stays as its poster. The page gives
   * the scene to the viewer with this `id`; `credit` names the source of the terrain,
   * `grades` adds the legend of a route coloured by grade, and `modes` a switch
   * between ways of seeing the terrain: the page listens to its `change` event.
   */
  viewer?: { id: string; label: string; credit?: string; grades?: boolean; modes?: { name: string; legend: string; value: string; options: readonly Option[] } };
}

const COPY = {
  ca: { km: 'Quilòmetre', elevation: 'Altitud', gain: 'Desnivell positiu', grade: 'Pendent', climb: 'Pujada', start: 'Sortida', finish: 'Arribada', hint: 'Fes scroll per recórrer el tram.', jump: 'Clica el perfil per saltar a un punt.', skip: 'Salta el recorregut', profile: 'Perfil de' },
  es: { km: 'Kilómetro', elevation: 'Altitud', gain: 'Desnivel positivo', grade: 'Pendiente', climb: 'Subida', start: 'Salida', finish: 'Llegada', hint: 'Haz scroll para recorrer el tramo.', jump: 'Pulsa el perfil para saltar a un punto.', skip: 'Saltar el recorrido', profile: 'Perfil de' },
  en: { km: 'Kilometre', elevation: 'Elevation', gain: 'Elevation gain', grade: 'Grade', climb: 'Climb', start: 'Start', finish: 'Finish', hint: 'Scroll to run the route.', jump: 'Click the profile to jump to a point.', skip: 'Skip the route', profile: 'Profile of' },
};

const { points, name, locale = 'ca', viewer, id = 'route' } = Astro.props;
const endId = `${id}-end`;
const copy = COPY[locale];
const summary = summarize(points);
const first = points[0]![0];
const climbs = detectClimbs(points);
const n = (v: number, digits: number): string => formatNumber(v, locale, digits, digits);
const chapters = climbs.map((c, i) => ({
  from: c.from,
  to: c.to,
  text: `${copy.climb} ${i + 1} · ${n(c.to - c.from, 1)} km · +${n(c.gainM, 0)} m · ${n(c.grade, 0)} %`,
}));

// Silhouette fitted to its own range: the route as a shape, as on the catalogue cover.
const span = summary.highest[1] - summary.lowest[1];
const low = summary.lowest[1] - span * 0.15;
const high = summary.highest[1] + span * 0.05;
const plot = createPlot(points, [low, high], 1000, 300);
const area = areaPath(points, plot);
const line = linePath(points, plot);

// The track is about 60 % of a screen per kilometre: steady pacing, whatever the length.
const length = Math.min(16, Math.max(4, summary.distanceKm * 0.6));
const data = { points, climbs: chapters, start: copy.start, finish: copy.finish, locale, low, high };
---

<tram-route-scroller class="scroller" style={`--track: ${length}`} data-viewer={viewer ? '' : undefined}>
  <script type="application/json" data-route set:html={JSON.stringify(data)} />
  <div class="track" data-track>
    <div class="stage">
      <div class:list={['sky', viewer && 'sky-viewer']}>
        {
          viewer ? (
            <>
            <Viewer3DShell id={viewer.id} label={viewer.label} locale={locale} fill>
              <RouteSilhouette slot="poster" area={area} line={line} />
              <div slot="text" class="notes" data-type="text-xs">
                {viewer.grades && (
                  <p class="grades">
                    <span>{copy.grade}</span>
                    {GRADE_LABELS.map((text, l) => (
                      <span class="grade"><i class="swatch" data-level={l + 1} />{text}</span>
                    ))}
                  </p>
                )}
                {viewer.credit && <p class="credit">{viewer.credit}</p>}
              </div>
            </Viewer3DShell>
            {viewer.modes && (
              <div class="modes">
                <SegmentedControl name={viewer.modes.name} legend={viewer.modes.legend} options={viewer.modes.options} value={viewer.modes.value} compact />
              </div>
            )}
            </>
          ) : (
            <RouteSilhouette area={area} line={line} />
          )
        }
      </div>

      <div class="readout">
        <p class="name" data-type="text-xs">{name}</p>
        <div class="km">
          <span class="label" data-type="text-xs">{copy.km}</span>
          <span class="figure" data-type="display-xl" data-numeric="tabular"><span data-out="km">{n(first, 2)}</span><span class="unit">{' km'}</span></span>
        </div>
        <dl class="stats">
          <div>
            <dt data-type="text-xs">{copy.elevation}</dt>
            <dd data-type="display-md" data-numeric="tabular"><span data-out="elevation">{n(elevationAt(points, first), 0)}</span><span class="unit">{' m'}</span></dd>
          </div>
          <div>
            <dt data-type="text-xs">{copy.gain}</dt>
            <dd class="gain" data-type="display-md" data-numeric="tabular"><span data-out="gain">{n(0, 0)}</span><span class="unit">{' m D+'}</span></dd>
          </div>
          <div>
            <dt data-type="text-xs">{copy.grade}</dt>
            <dd class="slope" data-out-level data-level="1" data-type="display-md" data-numeric="tabular"><span data-out="grade">{n(Math.round(gradeAt(points, first)), 0)}</span><span class="unit">{' %'}</span></dd>
          </div>
        </dl>
        <p class="chapter" data-type="display-sm" data-out="chapter" role="status">{copy.start}</p>
      </div>

      <div class="foot">
        <div class="foot-head">
          <p class="hint" data-type="text-xs">{copy.hint}<span class="hint-more">{` ${copy.jump}`}</span></p>
          <a class="skip" data-type="text-xs" href={`#${endId}`}>{copy.skip}<span aria-hidden="true">{' ↓'}</span></a>
        </div>
        <ElevationProfile points={points} label={`${copy.profile} ${name}`} annotate={false} cursor compact={Boolean(viewer)} locale={locale} />
      </div>
    </div>
  </div>
  <span id={endId} tabindex="-1"></span>
</tram-route-scroller>

<script>
  import './route-scroller.ts';
</script>

<style>
  .scroller {
    display: block;
    --progress: 0;
  }

  /* Without JavaScript the route is a static sheet; the scroll run exists only when live. */
  .scroller[data-live] .track {
    block-size: calc(var(--track) * 100dvh);
  }

  /* Readout, silhouette and profile each get their own area: nothing is drawn under a figure. */
  .stage {
    position: relative;
    display: grid;
    grid-template-areas: 'readout' 'silhouette' 'foot';
    grid-template-rows: auto minmax(0, 1fr) auto;
    gap: var(--tram-sys-space-4);
    min-block-size: 100dvh;
    padding-block: var(--tram-sys-space-5);
    overflow: hidden;
  }

  .scroller[data-live] .stage {
    position: sticky;
    inset-block-start: 0;
    block-size: 100dvh;
  }

  .sky {
    grid-area: silhouette;
    position: relative;
    min-block-size: var(--tram-sys-space-11);
  }

  /* Over the corner of the view, as the layer switch of a map. It only works with JavaScript. */
  .modes {
    position: absolute;
    inset-block-start: var(--tram-sys-space-2);
    inset-inline-end: var(--tram-sys-space-2);
    background: var(--tram-sys-surface);
  }

  .scroller:not([data-live]) .modes {
    display: none;
  }

  .notes {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--tram-sys-space-1) var(--tram-sys-space-5);
    color: var(--tram-sys-text-muted);
  }

  .credit,
  .grades {
    margin: 0;
  }

  /* The route's grade is never colour alone (7.3): the scale is named next to it. */
  .grades {
    display: flex;
    flex-wrap: wrap;
    gap: var(--tram-sys-space-1) var(--tram-sys-space-3);
  }

  /* On wide screens the profile below shows its own legend of the same scale: one is enough. */
  @media (width >= 48rem) {
    .grades {
      display: none;
    }
  }

  .grade {
    display: inline-flex;
    align-items: center;
    gap: var(--tram-sys-space-1);
    white-space: nowrap;
  }

  .swatch {
    inline-size: var(--tram-sys-space-4);
    block-size: var(--tram-sys-space-1);
  }

  .swatch[data-level='1'] {
    background: var(--tram-sys-data-grade-1);
  }

  .swatch[data-level='2'] {
    background: var(--tram-sys-data-grade-2);
  }

  .swatch[data-level='3'] {
    background: var(--tram-sys-data-grade-3);
  }

  .swatch[data-level='4'] {
    background: var(--tram-sys-data-grade-4);
  }

  .readout {
    grid-area: readout;
    position: relative;
    display: grid;
    align-content: start;
    gap: var(--tram-sys-space-3);
  }

  .name,
  .label,
  .stats dt,
  .hint {
    margin: 0;
    color: var(--tram-sys-text-muted);
  }

  /* Capitals only for the name of the route: a page of them is hard to read. */
  .name {
    text-transform: uppercase;
  }

  /* Elevation takes the colour of the grade scale: gained so far, and how steep it is right now. */
  .gain,
  .slope[data-level='3'] {
    color: var(--tram-sys-data-grade-3);
  }

  .slope[data-level='1'] {
    color: var(--tram-sys-data-grade-1);
  }

  .slope[data-level='2'] {
    color: var(--tram-sys-data-grade-2);
  }

  .slope[data-level='4'] {
    color: var(--tram-sys-data-grade-4);
  }

  .gain .unit,
  .slope .unit {
    color: inherit;
  }

  .km {
    display: grid;
  }

  .figure,
  .stats dd {
    margin: 0;
    white-space: nowrap;
  }

  /* Units step back, as in Measure. */
  .unit {
    font-size: 0.36em;
    font-weight: 700;
    letter-spacing: 0.04em;
    vertical-align: 0.12em;
    color: var(--tram-sys-text-muted);
  }

  .stats {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, max-content));
    gap: var(--tram-sys-space-2) var(--tram-sys-space-7);
    margin: 0;
  }

  /* The chapter is text, not the main action: no accent (7.3). */
  .chapter:empty {
    visibility: hidden;
  }

  .chapter {
    min-block-size: 1.2em;
    margin: 0;
    padding-inline-start: var(--tram-sys-space-3);
    /* The climb being run is the active thing on the page: it carries the accent. */
    border-inline-start: var(--tram-sys-space-1) solid var(--tram-sys-accent);
    color: var(--tram-sys-text);
  }

  .foot {
    grid-area: foot;
    position: relative;
    display: grid;
    gap: var(--tram-sys-space-2);
    padding-block-start: var(--tram-sys-space-3);
    border-block-start: var(--tram-sys-line-strong) solid var(--tram-sys-text);
    background: var(--tram-sys-surface);
  }

  .foot-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--tram-sys-space-4);
  }

  /* Running the route is an invitation, not a toll: what follows is always one tap away. */
  .skip {
    display: inline-flex;
    flex: none;
    align-items: center;
    /* A finger-sized target that takes one line of the layout: the room goes to the route. */
    margin-block: calc(var(--tram-sys-space-3) * -1);
    padding-block: var(--tram-sys-space-3);
    color: var(--tram-sys-text);
    font-weight: 700;
    text-underline-offset: 0.25em;
  }

  .skip:focus-visible {
    outline: var(--tram-sys-line-strong) solid var(--tram-sys-focus);
    outline-offset: var(--tram-sys-line-strong);
  }

  @media (width < 48rem) {
    .hint-more {
      display: none;
    }

    .stats {
      grid-template-columns: repeat(2, minmax(0, max-content));
    }

    /* With the 3D view the figures keep to one row: the relief gets the room. */
    .scroller[data-viewer] .stats {
      grid-template-columns: repeat(3, minmax(0, max-content));
      column-gap: var(--tram-sys-space-4);
    }
  }

  @media (width >= 64rem) {
    .stage {
      grid-template-areas: 'readout silhouette' 'foot foot';
      grid-template-columns: minmax(0, 2fr) minmax(0, 3fr);
      grid-template-rows: minmax(0, 1fr) auto;
      column-gap: var(--tram-sys-space-7);
    }

    .sky:not(.sky-viewer) {
      block-size: 80%;
      align-self: end;
    }
  }
</style>
