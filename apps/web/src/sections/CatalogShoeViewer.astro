---
import Viewer3DShell from '@tram/design-system/interactive/Viewer3DShell.astro';
import { type CatalogShoe, catalogName } from '../content/shoe-catalog';
import { catalogPhoto } from '../content/shoe-photos';

export interface Props {
  /** A shoe of the catalogue that has a photo model: the page asks `catalogPhoto` before drawing this. */
  shoe: CatalogShoe;
  /** Unique in the page. */
  id: string;
  /** Viewers of the same group turn together, as in the comparator. */
  group?: string;
  /** Shown as its own mirror image: the second shoe of a pair, so the two face each other. */
  mirror?: boolean;
  /** Without the note under the view: for when the page explains several viewers at once. */
  quiet?: boolean;
}

const { shoe, id, group, mirror, quiet = false } = Astro.props;
const photo = catalogPhoto(shoe);
if (!photo) throw new Error(`${catalogName(shoe)} has no photo model`);
// No figures of the shoe go to the scene: it is made of the photos alone.
const data = { turned: 'Sabatilla girada {degrees} graus.', photo };
---

<!-- A shoe of the catalogue in 3D, to turn by hand: its maker's photos laid over the outline read off them. The photo from the side is its poster; the scene loads when it comes into view. -->
<div class="shoe-viewer" data-shoe-viewer data-shoe-group={group} data-shoe-mirror={mirror === undefined ? undefined : String(mirror)} data-terrain={shoe.terrain}>
  <script type="application/json" set:html={JSON.stringify(data)} />
  <Viewer3DShell id={id} label={`${catalogName(shoe)} en 3D`} ready={quiet ? 'A punt: arrossega per girar.' : 'Vista 3D a punt. Arrossega o fes servir les fletxes per girar la sabatilla.'}>
    <img slot="poster" class="poster" src={photo.lateral} alt="" loading="lazy" decoding="async" />
    {
      !quiet && (
        <p slot="text" class="note" data-type="text-xs">
          {`Arrossega per girar-la; amb el teclat, les fletxes. No és un escaneig: són les fotos oficials de ${shoe.brand.name} posades sobre la seva silueta. De costat, de dalt i de darrere és fidel a les fotos; de front és aproximat. La mida és nominal: no se'n pot llegir cap mesura.`}
        </p>
      )
    }
  </Viewer3DShell>
</div>

<script>
  import '../islands/shoe-viewer-boot.ts';
</script>

<style>
  .poster {
    display: block;
    inline-size: 100%;
    block-size: 100%;
    object-fit: contain;
  }

  .note {
    margin: 0;
    color: var(--tram-sys-text-muted);
  }
</style>
