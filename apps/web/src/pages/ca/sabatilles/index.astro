---
import ShoeRow from '@tram/design-system/patterns/ShoeRow.astro';
import Button from '@tram/design-system/primitives/Button.astro';
import Heading from '@tram/design-system/primitives/Heading.astro';
import Stack from '@tram/design-system/primitives/Stack.astro';
import Text from '@tram/design-system/primitives/Text.astro';
import Band from '@tram/design-system/primitives/Band.astro';
import { catalogId, catalogPath, catalogShoes, drawable } from '../../../content/shoe-catalog';
import { pairSlug, SHOE_NOTICE, shoeName, shoePath, visiblePairs, visibleShoes } from '../../../content/shoes';
import Site from '../../../layouts/Site.astro';
import CatalogFilter from '../../../sections/CatalogFilter.astro';
import CatalogMaps from '../../../sections/CatalogMaps.astro';

const shoes = visibleShoes();
const pairs = visiblePairs();
// The catalogue, maker by maker: what each states on its own website.
const catalog = catalogShoes();
const makers = [...new Set(catalog.map((shoe) => shoe.brand.name))].sort((a, b) => a.localeCompare(b, 'ca')).map((name) => ({ name, shoes: catalog.filter((shoe) => shoe.brand.name === name) }));
---

<Site title="Sabatilles" trail={[]} description="Sabatilles de running d'asfalt i de muntanya en radiografia: el perfil amb cotes, la fitxa tècnica i la comparació entre models." placeholder notice={SHOE_NOTICE}>
  <Stack gap={4}>
    <Heading level={1} size="lg" kicker="Radiografia">Sabatilles</Heading>
    <Text size="lg" measure>Cada sabatilla dibuixada a partir de les seves mesures, com un plànol tècnic: l'alçada de l'escuma, el drop, la placa i els tacs. Totes les soles són a la mateixa escala.</Text>
  </Stack>
  {
    shoes.length > 0 ? (
      <Stack gap={0} as="ul">
        {shoes.map((shoe) => (
          <li><ShoeRow href={shoePath(shoe)} brand={shoe.brand.name} model={shoe.model} terrain={shoe.terrain} weightG={shoe.specs.weightG} specs={shoe.specs} /></li>
        ))}
      </Stack>
    ) : (
      <Text tone="muted">Encara no hi ha cap sabatilla publicada.</Text>
    )
  }
  {pairs.map(([a, b]) => <div><Button variant="primary" href={`/ca/comparar/${pairSlug(a, b)}/`}>{`Compara ${shoeName(a)} i ${shoeName(b)}`}</Button></div>)}
  {
    catalog.length > 0 && (
      <Band tone="plain" title="El catàleg">
        <div class="catalog" data-catalog>
          <Stack gap={7}>
            <Text measure>
              {`${catalog.length} models de ${makers.length} marques, cadascun amb el que la seva marca declara al seu web: pes, alçades, drop i tacs. No són mesures nostres ni de cap laboratori, i el que una marca no diu queda sense dada. Primer el mapa; a sota, la llista marca a marca, on la sola es dibuixa només quan la marca declara les dues alçades.`}
            </Text>
            <div><Button variant="secondary" href="/ca/comparar/">Compara dos models</Button></div>
            <CatalogFilter shoes={catalog} />
            <CatalogMaps shoes={catalog} />
            <div data-catalog-list>
              <Stack gap={7}>
                {makers.map((maker) => (
                  <section data-maker={maker.name}>
                    <Stack gap={3}>
                      <Heading level={3} size="sm">{`${maker.name} · ${maker.shoes.length}`}</Heading>
                      <Stack gap={0} as="ul">
                        {maker.shoes.map((shoe) => (
                          <li data-shoe={catalogId(shoe)} data-brand={shoe.brand.slug} data-terrain={shoe.terrain}>
                            <ShoeRow href={catalogPath(shoe)} brand={shoe.brand.name} model={shoe.model} terrain={shoe.terrain} weightG={shoe.weightG} specs={drawable(shoe)} dropMm={shoe.dropMm} />
                          </li>
                        ))}
                      </Stack>
                    </Stack>
                  </section>
                ))}
              </Stack>
            </div>
          </Stack>
        </div>
      </Band>
    )
  }
</Site>

<style>
  /* A band runs edge to edge on a phone, for the panels it holds. This list is in no panel, and keeps the page's margin. */
  @media (width < 48rem) {
    .catalog {
      padding-inline: var(--tram-sys-grid-margin);
    }
  }
</style>
