---
import type { GetStaticPaths } from 'astro';
import { type CatalogShoe, catalogShoes } from '../../../../content/shoe-catalog';
import { type Shoe, visibleShoes } from '../../../../content/shoes';
import CatalogShoePage from '../../../../sections/CatalogShoe.astro';
import LabShoe from '../../../../sections/LabShoe.astro';

// Two kinds of shoe share these addresses: the two of Phase 1, measured in a lab, and the catalogue,
// with what each maker states. A model that is in both keeps its lab page.
type Kinds = { shoe?: Shoe; entry?: CatalogShoe };
export const getStaticPaths = (() => {
  const lab = visibleShoes();
  const taken = new Set(lab.map((shoe) => `${shoe.brand.slug}/${shoe.slug}`));
  return [
    ...lab.map((shoe) => ({ params: { marca: shoe.brand.slug, model: shoe.slug }, props: { shoe } as Kinds })),
    ...catalogShoes()
      .filter((entry) => !taken.has(`${entry.brand.slug}/${entry.slug}`))
      .map((entry) => ({ params: { marca: entry.brand.slug, model: entry.slug }, props: { entry } as Kinds })),
  ];
}) satisfies GetStaticPaths;

const { shoe, entry } = Astro.props;
---

{shoe ? <LabShoe shoe={shoe} /> : entry ? <CatalogShoePage shoe={entry} /> : null}
