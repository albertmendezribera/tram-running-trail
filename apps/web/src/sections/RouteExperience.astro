---
import RouteScroller from '@tram/design-system/interactive/RouteScroller.astro';
import { ICGC_CREDIT, type Route, WORLD_NOTE } from '../content';
import { LANDMARKS } from '../content/landmarks';
import { FLIGHT_OFFERED, MODE_FIELD, MODE_LABELS, OFFERED_MODES } from '../islands/viewer-mode';

export interface Props {
  route: Route;
  /** Id of the 3D viewer. One per page. */
  id?: string;
  /** The name the silhouette shares with the row of the list that leads here (M6). */
  transition?: string;
}

const { route, id = 'route-viewer', transition } = Astro.props;
// What was modelled by hand along this route is said with the rest of what the view is made of.
const handmade = (LANDMARKS[route.slug] ?? []).map((landmark) => landmark.name);
const handNote = handmade.length ? ` Modelat a mà a partir de fotografies: ${handmade.join(', ')}.` : '';
// Both notes are about the view from the ground: they are said only while it is offered.
const groundNote = OFFERED_MODES.includes('walk') ? ` ${WORLD_NOTE}${handNote}` : '';
---

<!-- M2, "Recórrer el tram": the route run with the scroll, with its 3D view and a switch between the ways of seeing the terrain. -->
<div data-route-viewer={route.slug}>
  <RouteScroller
    points={route.profile}
    name={route.name}
    transition={transition}
    viewer={{
      id,
      label: `Vol en 3D pel recorregut de ${route.name}`,
      credit: `${ICGC_CREDIT}.${groundNote}`,
      flight: FLIGHT_OFFERED,
      grades: true,
      modes: { name: MODE_FIELD, legend: 'Com es veu el terreny', value: 'real', options: OFFERED_MODES.map((value) => ({ value, label: MODE_LABELS[value] })) },
    }}
  />
</div>

<script>
  import '../islands/route-viewer-boot.ts';
</script>
