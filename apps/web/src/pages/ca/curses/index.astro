---
import { formatDate } from '@tram/formats';
import Band from '@tram/design-system/primitives/Band.astro';
import Cluster from '@tram/design-system/primitives/Cluster.astro';
import Heading from '@tram/design-system/primitives/Heading.astro';
import Link from '@tram/design-system/primitives/Link.astro';
import Panel from '@tram/design-system/primitives/Panel.astro';
import Stack from '@tram/design-system/primitives/Stack.astro';
import Text from '@tram/design-system/primitives/Text.astro';
import { RACES, visible } from '../../../content';
import { buildDay, CALENDAR_ACCESSED, CALENDAR_SOURCES, calendarRaces, isOpen } from '../../../content/calendar';
import { facetDoors, hrefOf } from '../../../content/facets';
import Site from '../../../layouts/Site.astro';
import CalendarFilter from '../../../sections/CalendarFilter.astro';
import CalendarList from '../../../sections/CalendarList.astro';
import CalendarYear from '../../../sections/CalendarYear.astro';
import RaceList from '../../../sections/RaceList.astro';

const races = visible(RACES);
const sample = races.some((r) => r.isPlaceholder);
// The day the page is built parts what is to come from what has been run.
const today = buildDay();
const calendar = calendarRaces();
const coming = calendar.filter((race) => race.date >= today);
const run = calendar.filter((race) => race.date < today).reverse();
const pending = calendar.some((race) => !isOpen(race));
const MONTHS = ['gen.', 'febr.', 'març', 'abr.', 'maig', 'juny', 'jul.', 'ag.', 'set.', 'oct.', 'nov.', 'des.'];
const months = [...new Set(coming.map((race) => race.date.slice(0, 7)))].map((key) => ({ href: `#mes-${key}`, label: `${MONTHS[Number(key.slice(5)) - 1]} ${key.slice(0, 4)}` }));
// Every calendar read; what was read on an organiser's own page has no one address to point to.
const used = [...new Set(calendar.flatMap((race) => race.sources.map((source) => source.id)))].map((id) => CALENDAR_SOURCES[id]!).sort((a, b) => Number(!a.url) - Number(!b.url));
// The calendar cut by kind, by distance and by comarca: a page of its own for each cut with races in it.
const doors = facetDoors();
const notice = pending
  ? 'Versió de proves: una part de les curses ve de calendaris que encara no ens han donat permís per mostrar-les. Se’n citen fets, amb enllaç a la font, i no són a la versió de producció.'
  : sample
    ? 'Versió de proves: la data i el dorsal de la cursa amb recorregut són de mostra.'
    : undefined;
---

<Site
  title="Curses"
  trail={[]}
  description="Calendari de curses d'asfalt i de muntanya i de marxes de Catalunya, amb la data, el lloc i les distàncies de cada una i la font de cada dada."
  placeholder={sample || pending}
  credits={used.map((source) => `Calendari: ${source.name}`)}
  notice={notice}
>
  <Stack gap={4}>
    <Heading level={1} size="lg" kicker="Calendari">Curses</Heading>
    <Text size="lg" measure>Asfalt, muntanya i marxes a la mateixa llista. De cada prova, la data, el lloc i les distàncies, i d'on surt cada dada. Les que tenen el recorregut es poden recórrer en 3D.</Text>
    {
      calendar.length > 0 && (
        <nav aria-label="Parts d’aquesta pàgina" data-jump>
          <Cluster gap={4}>
            {coming.length > 0 && <Link href="#properes">{`Properes (${coming.length})`}</Link>}
            <Link href="#cerca">Cerca i filtres</Link>
            {doors.length > 0 && <Link href="#parts">Per tipus, distància i comarca</Link>}
            {run.length > 0 && <Link href="#disputades">{`Ja disputades (${run.length})`}</Link>}
          </Cluster>
        </nav>
      )
    }
  </Stack>
  {
    calendar.length > 0 && (
      <Band tone="plain" title="L'any com a perfil">
        <div class="coming"><CalendarYear races={calendar} today={today} /></div>
      </Band>
    )
  }
  {calendar.length > 0 && <div id="cerca"><CalendarFilter races={calendar} /></div>}
  {
    coming.length > 0 && (
      <div data-calendar-list id="properes">
        <Band tone="plain" title="Properes">
          <div class="coming">
            <Stack gap={6}>
              <nav aria-label="Mesos del calendari">
                <Cluster>{months.map((month) => <Link href={month.href}>{month.label}</Link>)}</Cluster>
              </nav>
              <CalendarList races={coming} level={3} />
            </Stack>
          </div>
        </Band>
      </div>
    )
  }
  {
    run.length > 0 && (
      <div data-calendar-list id="disputades">
        <Band tone="alt" title="Ja disputades">
          <Panel>
            <CalendarList races={run} level={3} anchor="fet" />
          </Panel>
        </Band>
      </div>
    )
  }
  {
    races.length > 0 && (
      <Band tone="tint" title="Amb el recorregut en 3D">
        <Panel>
          <RaceList races={races} />
        </Panel>
      </Band>
    )
  }
  {races.length + calendar.length === 0 && <Text tone="muted">Encara no hi ha cap cursa publicada.</Text>}
  {
    doors.length > 0 && (
      <Band tone="plain" title="El calendari per parts">
        <nav class="coming" id="parts" aria-label="El calendari per tipus, distància i comarca">
          <Stack gap={5}>
            {doors.map((group) => (
              <Stack gap={2}>
                <Heading level={3} size="sm">{group.title}</Heading>
                <Cluster gap={4}>{group.links.map((facet) => <Link href={hrefOf(facet)}>{`${group.title === 'Per comarca' ? facet.label : facet.title} (${facet.races.length})`}</Link>)}</Cluster>
              </Stack>
            ))}
          </Stack>
        </nav>
      </Band>
    )
  }
  {
    calendar.length > 0 && (
      <Band tone="tint" title="D'on surten les curses">
        <Panel>
          <Stack gap={3}>
            <Stack gap={2} as="ul">
              {used.map((source) => <li><Stack gap={1}>{source.url ? <Link href={source.url}>{source.name}</Link> : <Text>{source.name}</Text>}<Text size="sm" tone="muted">{source.terms}</Text></Stack></li>)}
            </Stack>
            <Text size="sm" tone="muted">Consultat el {formatDate(CALENDAR_ACCESSED, 'ca')}. De cada cursa només se'n prenen fets: nom, data, lloc, distàncies, organitzador i web. Cap font diu el desnivell, i no l'estimem.</Text>
          </Stack>
        </Panel>
      </Band>
    )
  }
</Site>

<style>
  /* A band runs edge to edge on a phone, for the panels it holds. This list is in no panel, and keeps the page's margin. */
  @media (width < 48rem) {
    .coming {
      padding-inline: var(--tram-sys-grid-margin);
    }
  }
</style>
