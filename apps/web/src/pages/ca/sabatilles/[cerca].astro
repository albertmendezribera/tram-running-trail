---
import type { GetStaticPaths } from 'astro';
import { needs } from '../../../content/shoe-needs';
import CatalogNeed from '../../../sections/CatalogNeed.astro';

// The catalogue by what somebody is looking for: `/ca/sabatilles/amples/`. A page only where the rule
// finds shoes; the addresses of the shoes themselves are a level deeper (`<marca>/<model>/`).
export const getStaticPaths = (() => needs().map((need) => ({ params: { cerca: need.slug }, props: { need } }))) satisfies GetStaticPaths;

const { need } = Astro.props;
---

<CatalogNeed need={need} />
