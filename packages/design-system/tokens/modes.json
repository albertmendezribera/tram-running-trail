{
  "$description": "Manifest del design system TRAM: quins fitxers formen la base i com s'apliquen els modes. Inspirat en el mòdul Resolver de DTCG; format propi (vegeu docs/explorations/E16-token-pipeline.md).",
  "sources": ["ref/color.json", "ref/space.json", "ref/type.json", "sys/color.json", "sys/space.json", "sys/type.json"],
  "modifiers": {
    "theme": {
      "attribute": "data-theme",
      "default": "light",
      "strategy": "light-dark",
      "contexts": {
        "light": { "colorScheme": "light", "sources": [] },
        "night": { "colorScheme": "dark", "sources": ["modes/theme/night.json"] }
      }
    },
    "terrain": {
      "attribute": "data-terrain",
      "default": "mixed",
      "strategy": "attribute",
      "contexts": {
        "mixed": { "sources": [] },
        "road": { "sources": ["modes/terrain/road.json"] },
        "trail": { "sources": ["modes/terrain/trail.json"] }
      }
    },
    "density": {
      "attribute": "data-density",
      "default": "comfortable",
      "strategy": "attribute",
      "contexts": {
        "comfortable": { "sources": [] },
        "compact": { "sources": ["modes/density/compact.json"] }
      }
    }
  },
  "contrast": [
    { "fg": "sys.text", "bg": "sys.surface", "min": 4.5 },
    { "fg": "sys.text", "bg": "sys.surface.alt", "min": 4.5 },
    { "fg": "sys.text.muted", "bg": "sys.surface", "min": 4.5 },
    { "fg": "sys.text.muted", "bg": "sys.surface.alt", "min": 4.5 },
    { "fg": "sys.accent.text", "bg": "sys.surface", "min": 4.5 },
    { "fg": "sys.on-accent", "bg": "sys.accent", "min": 4.5 },
    { "fg": "sys.focus", "bg": "sys.surface", "min": 3 },
    { "fg": "sys.data.road", "bg": "sys.surface", "min": 3 },
    { "fg": "sys.data.trail", "bg": "sys.surface", "min": 3 },
    { "fg": "sys.data.primary", "bg": "sys.surface", "min": 3 },
    { "fg": "sys.map.contour", "bg": "sys.surface", "min": 3 },
    { "fg": "sys.map.vegetation", "bg": "sys.surface", "min": 3 },
    { "fg": "sys.map.water", "bg": "sys.surface", "min": 3 },
    { "fg": "sys.data.active", "bg": "sys.surface", "min": 3, "level": "warn", "note": "Obert a E09: el punt actiu ha de portar contorn sys.text sobre paper." }
  ]
}
