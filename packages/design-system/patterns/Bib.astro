---
import type { Locale } from '@tram/formats';

type Terrain = 'road' | 'trail' | 'mixed';

export interface Props {
  /** The bib number. Null or undefined shows it as absent. */
  number: number | null | undefined;
  terrain: Terrain;
  /** Usually the race or the distance. */
  label?: string;
  size?: 'lg' | 'md';
  locale?: Locale;
}

const TERRAIN_LABEL: Record<Locale, Record<Terrain, string>> = {
  ca: { road: 'Asfalt', trail: 'Muntanya', mixed: 'Mixt' },
  es: { road: 'Asfalto', trail: 'Montaña', mixed: 'Mixto' },
  en: { road: 'Road', trail: 'Trail', mixed: 'Mixed' },
};
const BIB_LABEL: Record<Locale, string> = { ca: 'Dorsal', es: 'Dorsal', en: 'Bib' };

const { number, terrain, label, size = 'lg', locale = 'ca' } = Astro.props;
const absent = number === null || number === undefined;
---

<figure class="bib" data-size={size} data-terrain={terrain}>
  <figcaption class="head" data-type="text-xs">
    <span class="race">{label ?? BIB_LABEL[locale]}</span>
    <span class="terrain">{TERRAIN_LABEL[locale][terrain]}</span>
  </figcaption>
  <span class="number" data-type="display-xl" data-absent={absent ? '' : undefined}>{absent ? '—' : number}</span>
  <span class="foot" data-type="text-xs" aria-hidden="true">{BIB_LABEL[locale]}</span>
</figure>

<style>
  /*
   * A real bib: Tyvek sheet, four punched holes with reinforcement rings, the
   * number filling the sheet, and the tear-off strip at the bottom.
   */
  .bib {
    --ring: radial-gradient(
      circle closest-side,
      var(--tram-sys-surface) 46%,
      var(--tram-sys-rule-strong) 50% 60%,
      transparent 64%
    );
    --ring-size: var(--tram-sys-space-5);
    --ring-inset: var(--tram-sys-space-2);

    box-sizing: border-box;
    container-type: inline-size;
    display: grid;
    grid-template-rows: auto 1fr auto;
    inline-size: min(100%, 32rem);
    aspect-ratio: 4 / 3;
    margin: 0;
    padding: var(--tram-sys-space-6) var(--tram-sys-space-7) 0;
    border: var(--tram-sys-line-hairline) solid var(--tram-sys-rule-strong);
    border-radius: var(--tram-sys-radius-soft);
    background:
      var(--ring) left var(--ring-inset) top var(--ring-inset) / var(--ring-size) var(--ring-size) no-repeat,
      var(--ring) right var(--ring-inset) top var(--ring-inset) / var(--ring-size) var(--ring-size) no-repeat,
      var(--ring) left var(--ring-inset) bottom var(--ring-inset) / var(--ring-size) var(--ring-size) no-repeat,
      var(--ring) right var(--ring-inset) bottom var(--ring-inset) / var(--ring-size) var(--ring-size) no-repeat,
      var(--tram-sys-surface-alt);
    color: var(--tram-sys-text);
  }

  .bib[data-size='md'] {
    inline-size: min(100%, 15rem);
    padding: var(--tram-sys-space-4) var(--tram-sys-space-5) 0;
    --ring-size: var(--tram-sys-space-4);
  }

  /* The labels start past the reinforcement rings. */
  .head {
    display: flex;
    justify-content: space-between;
    gap: var(--tram-sys-space-3);
    padding-inline: var(--tram-sys-space-3);
    text-transform: uppercase;
  }

  .race {
    color: var(--tram-sys-text);
  }

  .terrain {
    color: var(--tram-sys-text-muted);
  }

  /* The number fills the sheet: four condensed digits take about 1.9 em. */
  .number {
    align-self: center;
    justify-self: center;
    font-size: 46cqi;
    line-height: 0.82;
    letter-spacing: -0.02em;
  }

  .number[data-absent] {
    color: var(--tram-sys-text-muted);
  }

  /* Tear-off strip: a perforated line, and the terrain in its stroke (7.3: never colour alone). */
  .foot {
    margin-inline: calc(var(--tram-sys-space-7) * -1);
    padding: var(--tram-sys-space-2) var(--tram-sys-space-7) var(--tram-sys-space-3);
    border-block-start: var(--tram-sys-line-strong) solid var(--tram-sys-data-primary);
    color: var(--tram-sys-text-muted);
    text-transform: uppercase;
    text-align: center;
  }

  [data-size='md'] .foot {
    margin-inline: calc(var(--tram-sys-space-5) * -1);
  }

  [data-terrain='trail'] > .foot {
    border-block-start-style: dashed;
  }

  [data-terrain='mixed'] > .foot {
    border-block-start-style: dotted;
  }
</style>
