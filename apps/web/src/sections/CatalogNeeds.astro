---
import Button from '@tram/design-system/primitives/Button.astro';
import Cluster from '@tram/design-system/primitives/Cluster.astro';
import Heading from '@tram/design-system/primitives/Heading.astro';
import Stack from '@tram/design-system/primitives/Stack.astro';
import Text from '@tram/design-system/primitives/Text.astro';
import { type Need, needPath, needs } from '../content/shoe-needs';

export interface Props {
  /** The need of the page it is on: the others are offered. */
  current?: Need;
  /** The level of its title. */
  level?: 2 | 3;
}

const { current, level = 3 } = Astro.props;
const all = needs();
// Two ways of asking: for how a shoe is made, and for what its maker says it is for.
const KINDS = [
  { kind: 'shape', label: 'Com la vols' },
  { kind: 'use', label: 'Per a què, segons la marca' },
] as const;
// The catalogue in the order of one figure: the same list, asked for by its address (`CatalogFilter`).
const RANKS = [
  { order: 'pes', label: 'Per pes' },
  { order: 'talo-alt', label: 'Per alçada al taló' },
  { order: 'drop-baix', label: 'Per drop' },
  { order: 'tacs', label: 'Per tacs' },
] as const;
---

<!--
  The way into the catalogue for whoever comes with a need and not with a maker in mind: «I want a wide
  shoe». Each need is a page of its own, so it is a link and works without a script.
-->
{
  all.length > 0 && (
    <nav class="needs" aria-label="Què busques?" data-needs>
      <Stack gap={3}>
        <Heading level={level} size="sm">{current ? 'Busques una altra cosa?' : 'Què busques?'}</Heading>
        {!current && <Text measure>Si no véns amb una marca al cap, comença pel que necessites. Cada llista diu amb quina regla s’ha fet, i què no pot dir.</Text>}
        {KINDS.map(({ kind, label }) => {
          const offered = all.filter((need) => need.kind === kind && need !== current);
          return (
            offered.length > 0 && (
              <div class="kind" data-need-kind={kind}>
                <span class="label" data-type="text-xs">{label}</span>
                <Cluster gap={2}>
                  {offered.map((need) => (
                    <span data-need={need.slug}>
                      <Button variant="secondary" size={current ? 'sm' : 'md'} href={needPath(need)}>{`${need.label} · ${need.shoes.length}`}</Button>
                    </span>
                  ))}
                </Cluster>
              </div>
            )
          );
        })}
        <div class="kind" data-need-kind="rank">
          <span class="label" data-type="text-xs">Tot el catàleg, en rànquing</span>
          <Cluster gap={2}>
            {RANKS.map((rank) => (
              <span data-rank-by={rank.order}>
                <Button variant="secondary" size={current ? 'sm' : 'md'} href={`/ca/sabatilles/?ordre=${rank.order}#llista`}>{rank.label}</Button>
              </span>
            ))}
          </Cluster>
        </div>
        {current && <div><Button variant="quiet" size="sm" href="/ca/sabatilles/">Tot el catàleg</Button></div>}
      </Stack>
    </nav>
  )
}

<style>
  .kind {
    display: grid;
    gap: var(--tram-sys-space-2);
  }

  .label {
    color: var(--tram-sys-text-muted);
    text-transform: uppercase;
  }
</style>
