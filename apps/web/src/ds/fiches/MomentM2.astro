---
import Band from '@tram/design-system/primitives/Band.astro';
import DataTable from '@tram/design-system/primitives/DataTable.astro';
import Panel from '@tram/design-system/primitives/Panel.astro';
import RouteScroller from '@tram/design-system/interactive/RouteScroller.astro';
import ClimbList from '@tram/design-system/patterns/ClimbList.astro';
import StatBlock from '@tram/design-system/patterns/StatBlock.astro';
import { kmStretches, summarize } from '@tram/design-system/patterns/elevation.ts';
import { CALONGE } from '../real-profile';
// Both views draw ICGC data: the orthophoto and the elevation model.
const CREDIT = 'Ortofoto i model d’elevacions: © Institut Cartogràfic i Geològic de Catalunya (ICGC), CC BY 4.0';

// Every figure comes from a real GPX: distance and elevation only.
const summary = summarize(CALONGE);
const distance = Number(summary.distanceKm.toFixed(2));
const gain = Math.round(summary.gainM);
const stats = [
  { label: 'Distància', value: distance, unit: 'km' },
  { label: 'Desnivell positiu', value: gain, unit: 'm-gain', tone: 'grade' },
  { label: 'Altitud màxima', value: summary.highest[1], unit: 'm' },
  { label: 'Km-esforç', value: Number((distance + gain / 100).toFixed(1)), unit: 'km-effort' },
] as const;
const rows = kmStretches(CALONGE).map((r) => ({ km: r.km, gain: Math.round(r.gainM), loss: Math.round(r.lossM), grade: Math.round(r.grade) }));
---

<header class="intro">
  <p class="kicker" data-type="text-xs">Moment firma · M2 · prototip</p>
  <h1 class="title" data-type="display-lg">Recórrer el tram</h1>
  <p class="lede" data-type="text-lg">
    Una sortida real a Calonge, quilòmetre a quilòmetre. La càmera vola pel relleu real mentre fas scroll, el perfil queda enganxat a baix i les xifres canvien com en un marcador.
  </p>
</header>

<RouteScroller
  points={CALONGE}
  name="Calonge · sortida real"
  viewer={{
    id: 'm2-viewer',
    label: 'Vol en 3D pel recorregut de Calonge',
    credit: CREDIT,
    grades: true,
    modes: { name: 'm2-viewer-mode', legend: 'Com es veu el terreny', value: 'real', options: [{ value: 'real', label: 'Realista' }, { value: 'map', label: 'Cartogràfic' }] },
  }}
/>

<Band tone="tint" title="Full de resultats">
  <Panel>
    <StatBlock stats={stats} lead />
  </Panel>
  <div class="pair">
    <Panel title="Pujades">
      <ClimbList label="Pujades de la sortida a Calonge" points={CALONGE} />
    </Panel>
    <Panel>
      <DataTable
        caption="Trams per quilòmetre"
        density="compact"
        columns={[
          { key: 'km', label: 'Km', unit: 'km' },
          { key: 'gain', label: 'D+', unit: 'm-gain' },
          { key: 'loss', label: 'D−', unit: 'm' },
          { key: 'grade', label: 'Pendent', diverging: { max: 20, suffix: '%' } },
        ]}
        rows={rows}
      />
    </Panel>
  </div>
</Band>

<script>
  import type { TramRouteScroller } from '@tram/design-system/interactive/route-scroller.ts';
  import type { SceneLoader } from '@tram/design-system/interactive/viewer-3d-shell.ts';
  import { MODE_FIELD, preferredMode, rememberMode } from '../viewer-mode';

  // Three.js and the terrain load only when the viewer asks for its scene.
  void customElements.whenDefined('tram-viewer-3d').then(() => {
    const viewer = document.getElementById('m2-viewer') as (HTMLElement & { loader: SceneLoader }) | null;
    const scroller = viewer?.closest<TramRouteScroller>('tram-route-scroller');
    if (!viewer || !scroller) return;
    // The switch shows the mode this reader last chose.
    const chosen = scroller.querySelector<HTMLInputElement>(`input[name="${MODE_FIELD}"][value="${preferredMode()}"]`);
    if (chosen) chosen.checked = true;
    // Remembered at once, whether or not the 3D is running yet.
    scroller.addEventListener('change', (event) => {
      const input = event.target as HTMLInputElement;
      if (input.name === MODE_FIELD && (input.value === 'real' || input.value === 'map')) rememberMode(input.value);
    });
    viewer.loader = (context) => import('../calonge-viewer').then((m) => m.mount(context, scroller));
  });
</script>

<style>
  .intro {
    display: grid;
    gap: var(--tram-sys-space-3);
    padding-block-end: var(--tram-sys-space-5);
    border-block-end: var(--tram-sys-line-strong) solid var(--tram-sys-text);
  }

  /* A short bar in the accent opens the page: colour that marks, not decorates. */
  .kicker {
    display: flex;
    align-items: center;
    gap: var(--tram-sys-space-2);
    margin: 0;
    color: var(--tram-sys-text-muted);
    text-transform: uppercase;
  }

  .kicker::before {
    inline-size: var(--tram-sys-space-6);
    block-size: var(--tram-sys-space-1);
    background: var(--tram-sys-accent);
    content: '';
  }

  .title {
    margin: 0;
  }

  .lede {
    max-inline-size: 46ch;
    margin: 0;
  }

  .pair {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--tram-sys-space-6);
  }

  @media (width >= 64rem) {
    .pair {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
