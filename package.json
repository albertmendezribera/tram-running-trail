{
  "name": "tram",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "tokens:build": "pnpm --filter @tram/design-system tokens:build",
    "tokens:check": "pnpm --filter @tram/design-system tokens:check",
    "test": "pnpm -r --if-present test",
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "eslint . && stylelint \"apps/**/*.{astro,css}\"",
    "test:lint": "node --test \"eslint/*.test.mjs\"",
    "check": "pnpm tokens:check && pnpm typecheck && pnpm lint && pnpm test && pnpm test:lint && pnpm --filter @tram/design-system test:browser"
  },
  "devDependencies": {
    "astro-eslint-parser": "3.2.0",
    "eslint": "10.14.0",
    "eslint-plugin-astro": "3.2.1",
    "postcss-html": "2.0.0",
    "stylelint": "18.0.0",
    "typescript-eslint": "8.72.2"
  }
}
