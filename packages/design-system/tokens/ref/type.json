{
  "$description": "Valors crus de tipografia (E08). Les mides són fluides: $value és la mida a 1440 px i fluidMin la mida a 390 px.",
  "ref": {
    "font": {
      "$type": "fontFamily",
      "display": { "$value": ["Sofia Sans Extra Condensed", "sans-serif"] },
      "text": { "$value": ["Sofia Sans", "sans-serif"] }
    },
    "weight": {
      "$type": "fontWeight",
      "regular": { "$value": 400 },
      "medium": { "$value": 500 },
      "bold": { "$value": 700 },
      "extrabold": { "$value": 800 }
    },
    "leading": {
      "$type": "number",
      "tight": { "$value": 0.95 },
      "snug": { "$value": 1.05 },
      "data": { "$value": 1.3 },
      "text": { "$value": 1.5 }
    },
    "tracking": {
      "$type": "number",
      "$description": "En em.",
      "tight": { "$value": -0.01 },
      "none": { "$value": 0 },
      "open": { "$value": 0.01 },
      "label": { "$value": 0.02 }
    },
    "size": {
      "$type": "dimension",
      "2xs": { "$value": { "value": 13, "unit": "px" }, "$extensions": { "com.tramrun": { "fluidMin": { "value": 12, "unit": "px" } } } },
      "xs": { "$value": { "value": 14, "unit": "px" }, "$extensions": { "com.tramrun": { "fluidMin": { "value": 13, "unit": "px" } } } },
      "sm": { "$value": { "value": 15, "unit": "px" }, "$extensions": { "com.tramrun": { "fluidMin": { "value": 14, "unit": "px" } } } },
      "md": { "$value": { "value": 16, "unit": "px" }, "$extensions": { "com.tramrun": { "fluidMin": { "value": 15, "unit": "px" } } } },
      "base": { "$value": { "value": 17, "unit": "px" }, "$extensions": { "com.tramrun": { "fluidMin": { "value": 16, "unit": "px" } } } },
      "lg": { "$value": { "value": 20, "unit": "px" }, "$extensions": { "com.tramrun": { "fluidMin": { "value": 18, "unit": "px" } } } },
      "xl": { "$value": { "value": 40, "unit": "px" }, "$extensions": { "com.tramrun": { "fluidMin": { "value": 28, "unit": "px" } } } },
      "2xl": { "$value": { "value": 72, "unit": "px" }, "$extensions": { "com.tramrun": { "fluidMin": { "value": 44, "unit": "px" } } } },
      "3xl": { "$value": { "value": 120, "unit": "px" }, "$extensions": { "com.tramrun": { "fluidMin": { "value": 64, "unit": "px" } } } },
      "4xl": { "$value": { "value": 240, "unit": "px" }, "$extensions": { "com.tramrun": { "fluidMin": { "value": 120, "unit": "px" } } } }
    }
  }
}
