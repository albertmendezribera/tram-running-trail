---
import { Font } from 'astro:assets';
import '@tram/design-system/tokens.css';
import '@tram/design-system/base.css';
import '@tram/design-system/fonts/fallbacks.css';
import SiteFooter from '@tram/design-system/patterns/SiteFooter.astro';
import SiteFrame from '@tram/design-system/patterns/SiteFrame.astro';
import SiteHeader from '@tram/design-system/patterns/SiteHeader.astro';
import SiteTrail from '@tram/design-system/patterns/SiteTrail.astro';

export interface Props {
  title: string;
  description: string;
  /** `data-terrain` of the page: a race or a shoe gives the page its world. */
  terrain?: 'road' | 'trail' | 'mixed' | undefined;
  /** Pages built on sample data are never offered to search engines. */
  placeholder?: boolean | undefined;
  credits?: readonly string[] | undefined;
  notice?: string | undefined;
  /** The image the page is shared with (M5): its path, e.g. `/og/rutes/calonge.png`, and what it shows, in words. */
  image?: { path: string; alt: string } | undefined;
  /** schema.org data of the page (CLAUDE.md 11). */
  jsonLd?: Record<string, unknown> | ReadonlyArray<Record<string, unknown>> | undefined;
  /**
   * The pages this one hangs from, below the home page and in order: `[{ label: 'Curses', href: '/ca/curses/' }]`.
   * Given, even empty, the page shows the way back up and tells it to search engines (`BreadcrumbList`,
   * CLAUDE.md 11). The home page gives none.
   */
  trail?: ReadonlyArray<{ label: string; href: string }> | undefined;
}

const { title, description, terrain = 'mixed', placeholder = false, credits, notice, image, jsonLd, trail } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const steps = trail ? [{ label: 'Inici', href: '/ca/' }, ...trail] : undefined;
// The same trail for search engines, down to the page itself. Like every schema.org of the site, only for a page that is offered to them.
const breadcrumbs =
  steps && !placeholder
    ? {
        '@context': 'https://schema.org',
        '@type': 'BreadcrumbList',
        itemListElement: [...steps.map((step) => ({ name: step.label, item: new URL(step.href, Astro.site).href })), { name: title, item: canonical.href }].map((step, i) => ({ '@type': 'ListItem', position: i + 1, ...step })),
      }
    : undefined;
const LINKS = [
  { href: '/ca/curses/', label: 'Curses' },
  { href: '/ca/rutes/', label: 'Rutes' },
  { href: '/ca/sabatilles/', label: 'Sabatilles' },
];
---

<!doctype html>
<html lang="ca" data-terrain={terrain}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{`${title} · TRAM`}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="TRAM" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {
      image && (
        <>
          <meta property="og:image" content={new URL(image.path, Astro.site)} />
          <meta property="og:image:width" content="1200" />
          <meta property="og:image:height" content="630" />
          <meta property="og:image:alt" content={image.alt} />
          <meta name="twitter:card" content="summary_large_image" />
        </>
      )
    }
    {placeholder && <meta name="robots" content="noindex, nofollow" />}
    <Font cssVariable="--tram-ref-font-display" preload />
    <Font cssVariable="--tram-ref-font-text" preload />
    <!-- Before the first paint: the theme the reader chose, not the one of the phone. -->
    <script is:inline>
      try {
        if (localStorage.getItem('tram-theme') === 'night') document.documentElement.dataset.theme = 'night';
      } catch {}
    </script>
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
    {breadcrumbs && <script type="application/ld+json" data-breadcrumbs set:html={JSON.stringify(breadcrumbs)} />}
  </head>
  <body data-type="text-md">
    <SiteFrame>
      <SiteHeader slot="header" home="/ca/" links={LINKS} current={Astro.url.pathname} />
      {steps && <SiteTrail slot="trail" items={steps} />}
      <slot />
      <SiteFooter slot="footer" credits={credits} notice={notice} />
    </SiteFrame>
  </body>
</html>
