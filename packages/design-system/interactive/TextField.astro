---
export interface Props {
  /** Name of the field in its form. */
  name: string;
  /** What is written in it, said over the field: there is no placeholder to say it instead. */
  label: string;
  /** What is already written in it. */
  value?: string;
  /** The most letters it takes. */
  maxlength?: number;
}

// The browser's own text field, for a few words: a name, a place.
const { name, label, value, maxlength } = Astro.props;
---

<label class="field">
  <span class="label" data-type="text-xs">{label}</span>
  <input class="input" type="text" name={name} value={value} maxlength={maxlength} data-type="text-sm" autocomplete="off" />
</label>

<style>
  .field {
    display: grid;
    gap: var(--tram-sys-space-1);
    min-inline-size: 0;
  }

  .label {
    color: var(--tram-sys-text-muted);
    text-transform: uppercase;
  }

  .input {
    box-sizing: border-box;
    min-block-size: var(--tram-sys-space-9);
    min-inline-size: 0;
    inline-size: 100%;
    padding-inline: var(--tram-sys-space-3);
    border: var(--tram-sys-line-hairline) solid var(--tram-sys-rule-strong);
    border-radius: var(--tram-sys-radius-soft);
    color: var(--tram-sys-text);
    background: var(--tram-sys-surface);
    appearance: none;
  }

  .input:hover {
    background: var(--tram-sys-surface-alt);
  }

  .input:focus-visible {
    outline: var(--tram-sys-line-strong) solid var(--tram-sys-focus);
    outline-offset: var(--tram-sys-line-strong);
  }
</style>
